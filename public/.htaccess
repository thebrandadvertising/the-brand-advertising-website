RewriteEngine On
RewriteBase /
RewriteCond %{HTTP_HOST} ^www\.thebrandadvertising\.com$ [NC]
RewriteRule ^ https://thebrandadvertising.com%{REQUEST_URI} [R=301,L]
RewriteRule ^auto-hood-branding/[^/]+/?$ /services/auto-hood-branding [R=301,L]
RewriteRule ^work/?$ /campaigns [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
